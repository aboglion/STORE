# ============================================================
# Supabase — create your project at https://supabase.com
# then fill in the values below.
# Copy this file to `.env.local` and replace the placeholders.
# ============================================================

# Public URL of your Supabase project, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never expose to the client.
# Used by server actions to create orders and manage admin data.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for canonical links / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Database backup system (optional overrides)
# ------------------------------------------------------------
# Host directory where the last N backups are stored (OUTSIDE Docker).
# Default in production: /home/uns/store-backups (bind-mounted to /backups).
# BACKUP_DIR=/home/uns/store-backups

# Direct Postgres connection used by pg_dump / pg_restore inside the container.
# These match the local Supabase defaults (PG v17) — override only if changed.
# PGPORT=54322
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=postgres

# IANA timezone for the daily backup schedule (Israel time).
# BACKUP_TZ=Asia/Jerusalem
